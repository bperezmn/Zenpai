# dependencias y builds
node_modules/
dist/

# llaves y configuración local (Supabase, etc.) — NUNCA al repo
.env
.env.*
!.env.example
*.local

# sistema
.DS_Store

# assets fuente pesados (no necesarios para correr la app):
# los JPG originales de los que salieron las WebP optimizadas de app/public/assets
app/_assets_jpg_original/
# las imágenes del prototipo histórico (~440 MB; el prototipo quedó superado por app/)
prototype/assets/
prototype/*.jpg
prototype/*.png

# modelos 3D pesados generados (Tripo/Meshy) y respaldos automáticos de Blender: no se versionan
blender/plantas/*.glb
*.blend1
# recortes de plantas: se versionan como WebP sin pérdida (blender/plantas/*_cutout.webp);
# los PNG intermedios (descargas de Higgsfield) no
blender/plantas/*.png

# fotos 4K originales del set fotorrealista (GPT Image 2.5): ~2 GB, fuera del repo
fotos_4k/raw/
fotos_4k/color/

# supabase CLI (link)
supabase/.temp/
